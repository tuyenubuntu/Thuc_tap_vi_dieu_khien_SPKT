#include<tv_boards.c>
unsigned int8 n, trst=0, m;

void led_flash ()
{
      // 1. Dieu khien 32 LED chop tat 5 lan
      n=0;
      if (n < 10)
      {
            led32.ledx32 =~ led32.ledx32;
            led32_display();
            delay_ms(100);
      }
      else
      {
         n=0;
         trst++;
      }
}


void on_r2l ()
{
      // Bat tu phai sang trai
      if (n <= 32)
      {
         led32.ledx32 =~ (0xffffffff  << n); 
         led32_display();
         delay_ms(100);
         n++;
      }
      
      else
      {
      n = 0;
      trst++;
      }
}
      
