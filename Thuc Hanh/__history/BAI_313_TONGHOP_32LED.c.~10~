//Bat Tat tu trong ra
void on_off_fi ()
{
      m = 0;
      while (n < 2) 
      {
         //Bat tu trong ra
         if (n <=16)
         {
            led32.ledx16[1] =~ (0xffff >> n);
            led32.ledx16[0] =~ (0xffff << n);
            led32_display();
            delay_ms (100);
            n++;
         }
         else
         {
            n=0;
         }
         
         //Tat tu trong ra
         if (n <= 16)
         {
            led32.ledx16[1] = (0xffff >> n);
            led32.ledx16[0] = (0xffff << n);
            led32_display();
            delay_ms (100);
            n++;
         }  
         else
         {
               n=0;
         }
         
         m++;
         trst++;
      }
}

//Bat tat tu ngoai vao
