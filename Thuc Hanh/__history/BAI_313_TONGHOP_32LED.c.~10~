{
      n = 0;
      while (n < 2) 
      {
         //Bat tu ngoai vao
         if (m <=16)
         {
            led32.ledx16[1] =~ (0xffff << m);
            led32.ledx16[0] =~ (0xffff >> m);
            led32_display();
            delay_ms (100);
            m++;
         }
         else
         {
            m=0;
         }
         //Tat tu ngoai vao
         if (m <=16)
         {
            led32.ledx16[1] = (0xffff << m);
            led32.ledx16[0] = (0xffff >> m);
            led32_display();
            delay_ms (100);
            m++;
         }  
         else
         {
            m=0;
         }
         n++;
