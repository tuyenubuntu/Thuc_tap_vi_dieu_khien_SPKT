       }

}


void main()
{
      system_init();  // Bien dich thanh cong - Go 2-3 chu dau - roi nhan Ctr + Khoang trang
      if (trst==0) led_flash ();
      else if (trst==1) on_r2l();
      else if (trst==2) off_r2l();
      else if (trst==3) led_flash();
      else if (trst==4) on_l2r();
      else if (trst==5) off_l2r();
      else if (trst==6) led_flash();
      else if (trst==6) on_off_fo ();
      else if (trst==6) led_flash();
      else if (trst==6) on_off_fi ();
}


