#include<tv_boards.c>
unsigned int8 n=0, trst=0, count_down = 0, count_up = 0;

void clear_all ()
{
   while (true)
   {
   if (input (CLR) == 0) led32.ledx16[0] = 0;
   }
}

void on_PST ()
{
   count_down = 0;
   while (count_up <=17)
   {
      if((inputcd (UP) == 0) && count_up <=16)
      {
         count_up ++;
         led32.ledx16[0] =~ (0xffff  << count_up); 
         led32_display();
         delay_ms(100);
      }
      else if (count_up > 16)
      {
         count_up = 0;
      }
   }


}

void off_TSP ()
{  
   count_up = 0;
   while (true)
   {
      if((inputcd (DW) == 0) && count_down <=16)
      {
         count_down ++;
         led32.ledx16[0] = (0xffff  >> count_down); 
         led32_display();
         delay_ms(100);
   
      }
      
      else if (count_down > 16)
      {
         count_down = 0;
      }
   }


}

void main()
{
      system_init();  // Bien dich thanh cong - Go 2-3 chu dau - roi nhan Ctr + Khoang trang
//!      led32.ledx16[0] = 0;
      while (true)
      {
         on_PST ();
         if (led32.ledx16[0] == 0xffff )
         {
            off_TSP ();
         }
         clear_all ();
      }
}


