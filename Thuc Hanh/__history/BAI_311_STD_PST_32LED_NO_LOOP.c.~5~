#include<tv_boards.c>
unsigned int8 n, trst=0;
unsigned int8 m, t;

void on_r2l ()
{
      n = 0;
      if (n < 32) 
      {
         led32.ledx32 =~ (0xffffffff  << m); 
         led32_display();
         delay_ms(100);
         n++;
      }
      
      else
      {
      n = 0;
      trst ++;
      }
}


void off_r2l ()
{
      n = 0;
      if (n < 32) 
      {
         led32.ledx32 = (0xffffffff  << m); 
         led32_display();
         delay_ms(100);
         n++;
      }
      
      else
      {
      n = 0;
      trst ++;
      }
}


void main()
{
      system_init();  // Bien dich thanh cong - Go 2-3 chu dau - roi nhan Ctr + Khoang trang
