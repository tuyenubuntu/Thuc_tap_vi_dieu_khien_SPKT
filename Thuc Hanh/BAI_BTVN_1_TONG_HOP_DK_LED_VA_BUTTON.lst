.................... 
.................... unsigned int8 n=0, count = 0, m = 0;
.................... // Tao bien che do dieu khien KED va bien bao da full LED
.................... // mode == false thi la manua, mode == true la auto chay LED voi 1 lan nhan
.................... // Bien full de bao trang thai 16 LED dau tien
.................... bool mode = false, full = false; 
.................... 
.................... void modes()
.................... {
....................    if (inputcd (CLR) == 0) //Neu nhan CLR
....................    // Nhat CLR la clear het den voi tra cac gia tri ve mac dinh
....................    {
....................       led32.ledx16[0] = 0; //Tat het LED
....................       led32_display();
....................       count = 0; full = false; // Tra ve gia tri mac dinh
....................       
....................       //Doi them 1s, neu du dieu kien thi qua che do moi
....................       delay_ms(1000); 
....................       if (inputcd (CLR) == 0) //Sau 1s ma van con nhan
....................       {
....................          mode = ~mode; //Thi chuyen sang che do khac (nguoc lai so voi hien tai)
....................          // Neu mode = true thi chuyen sang che do auto chay LED
....................          if (mode==1) //Neu mode == true thi nhap nhay 5 lan, de bao kich hoat che do auto
....................          {
....................             for (n =0 ; n <10; n++)
....................             {
....................                led32.ledx16[0] = ~led32.ledx16[0];
....................                led32_display();
....................                delay_ms (500);
....................             }
....................          }
....................          // Neu van la false thi van o che do manual, thi sang lien tuc 3s
....................          else
....................          {
....................                led32.ledx16[0] = 0xffff;
....................                led32_display();
....................                delay_ms (300);
....................                led32.ledx16[0] = 0;
....................                led32_display();
....................          }
....................       }
....................       //Neu sau 1s ma khong con nhan thi coi nhu khong doi che do, van la che do cu
....................       else  mode = mode;
....................    }
.................... }
